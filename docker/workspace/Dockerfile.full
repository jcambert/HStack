ARG HSTACK_WORKSPACE_VERSION=0.2.0
FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM hstack/workspace-base:${HSTACK_WORKSPACE_VERSION}

COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

ARG HSTACK_VERSION=0.2.0
ARG HSTACK_REVISION=unknown
ARG HSTACK_CREATED=unknown
ARG HSTACK_TOOLCHAIN_SHA256=development
ARG CLAUDE_CODE_VERSION=2.1.289
ARG CODEX_VERSION=0.160.0
ARG HERMES_VERSION=0.21.5
ARG HERMES_RELEASE_TAG=v2026.9.24
ARG HERMES_COMMIT=f97608f178d1ffeca59860195ab7da295f7c8e5f
ARG OPENCODE_VERSION=1.18.34
ARG TARGETARCH=amd64

LABEL org.opencontainers.image.title="HermesStack workspace full" \
      org.opencontainers.image.version="${HSTACK_VERSION}" \
      org.opencontainers.image.revision="${HSTACK_REVISION}" \
      org.opencontainers.image.created="${HSTACK_CREATED}" \
      io.hstack.toolchain.sha256="${HSTACK_TOOLCHAIN_SHA256}" \
      io.hstack.kind="workspace-full" \
      io.hstack.agent.claude="${CLAUDE_CODE_VERSION}" \
      io.hstack.agent.codex="${CODEX_VERSION}" \
      io.hstack.agent.hermes="${HERMES_VERSION}" \
      io.hstack.agent.opencode="${OPENCODE_VERSION}"

USER root

# Hermes currently builds native Node modules during its official install.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       build-essential cmake python3-dev libffi-dev libatomic1 \
    && rm -rf /var/lib/apt/lists/*

# Claude Code: install the exact official native release artifact used by the
# native installer and verify Anthropic's published SHA-256 digest.
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) claude_asset="claude-linux-x64.tar.gz"; claude_sha="aa184fe26777b16e18230da937ffe369e40f261bc65405520cafd7bd95783bef" ;; \
      arm64) claude_asset="claude-linux-arm64.tar.gz"; claude_sha="f1dd579805a35402555a833dde1ee509ff6744921dd3f706c82831c7b31cd65f" ;; \
      *) echo "Unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL \
      "https://github.com/anthropics/claude-code/releases/download/v${CLAUDE_CODE_VERSION}/${claude_asset}" \
      -o /tmp/claude.tar.gz; \
    echo "${claude_sha}  /tmp/claude.tar.gz" | sha256sum -c -; \
    mkdir -p /tmp/claude-extract; \
    tar -xzf /tmp/claude.tar.gz -C /tmp/claude-extract; \
    claude_binary="$(find /tmp/claude-extract -type f -name claude -print -quit)"; \
    test -n "$claude_binary"; \
    install -m 0755 "$claude_binary" /usr/local/bin/claude; \
    rm -rf /tmp/claude.tar.gz /tmp/claude-extract; \
    claude --version | grep -F "${CLAUDE_CODE_VERSION}"

# Codex and OpenCode both document npm as a supported package-manager install.
# Exact versions keep the image reproducible and select their platform packages.
RUN set -eux; \
    npm install -g --omit=dev \
      "@openai/codex@${CODEX_VERSION}" \
      "opencode-ai@${OPENCODE_VERSION}"; \
    codex --version | grep -F "${CODEX_VERSION}"; \
    opencode --version | grep -F "${OPENCODE_VERSION}"; \
    npm cache clean --force

# Hermes Agent: build the exact official release source using the release's
# committed uv.lock. This follows the dependency-install path used by the
# upstream production Dockerfile and avoids mixing a newer installer with an
# older pinned source tree.
RUN set -eux; \
    export UV_NO_CONFIG=1; \
    git clone --filter=blob:none --no-checkout \
      https://github.com/NousResearch/hermes-agent.git /opt/hermes; \
    git -C /opt/hermes fetch --depth 1 origin "${HERMES_COMMIT}"; \
    git -C /opt/hermes checkout --detach "${HERMES_COMMIT}"; \
    test "$(git -C /opt/hermes rev-parse HEAD)" = "${HERMES_COMMIT}"; \
    cd /opt/hermes; \
    uv sync --frozen --no-install-project; \
    uv pip install --no-cache-dir --no-deps -e "."; \
    ln -s /opt/hermes/.venv/bin/hermes /usr/local/bin/hermes; \
    HERMES_HOME=/tmp/hstack-hermes-build hermes --version | grep -F "${HERMES_VERSION}"; \
    rm -rf /tmp/hstack-hermes-build

RUN apt-get purge -y --auto-remove build-essential \
    && rm -rf /var/lib/apt/lists/* /tmp/*

USER hstack
WORKDIR /workspace
