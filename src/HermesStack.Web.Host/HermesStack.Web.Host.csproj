<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>hstack-web</AssemblyName>
    <RootNamespace>HermesStack.Web.Host</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HermesStack.Web.Client/HermesStack.Web.Client.csproj" />
    <ProjectReference Include="../HermesStack.Web.Contracts/HermesStack.Web.Contracts.csproj" />
    <ProjectReference Include="../HermesStack.Domain/HermesStack.Domain.csproj" />
    <ProjectReference Include="../HermesStack.Application/HermesStack.Application.csproj" />
    <ProjectReference Include="../HermesStack.Infrastructure/HermesStack.Infrastructure.csproj" />
    <ProjectReference Include="../HermesStack.Docker/HermesStack.Docker.csproj" />
    <ProjectReference Include="../HermesStack.Aspire/HermesStack.Aspire.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>
  <ItemGroup>
    <!-- Separate SPA entrypoint is kept outside wwwroot to avoid
         duplicating the referenced Client static web asset in the SDK. -->
    <Content Include="spa/index.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../../docs/INDEX.md" Link="manual/INDEX.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
    <Content Include="../../docs/guides/DEVELOPPER-AVEC-HSTACK.md" Link="manual/DEVELOPPER-AVEC-HSTACK.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
